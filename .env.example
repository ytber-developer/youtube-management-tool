PORT=9000
NODE_ENV=development
CONCURRENT_TABS=3

CHROME_EXECUTABLE="C:\Program Files\Google\Chrome\Application\chrome.exe"
CHROME_USER_DATA_DIR="C:\Users\Public\AppData\Local\Google\Chrome\User Data"
CHROME_USE_TEMP_PROFILE=true
# Tốc độ upload tối thiểu (KB/s) để tính thời gian chờ upload xong sau khi Publish (mặc định 512)
UPLOAD_MIN_SPEED_KBPS=512

# Mặc định backend chỉ nghe trên máy này. Đặt 0.0.0.0 nếu cần mở cho máy khác trong LAN (API không có đăng nhập!)
HOST=127.0.0.1
# Origin frontend được phép gọi API ngoài localhost (phân tách bằng dấu phẩy), vd http://192.168.1.10:3000
CORS_ORIGINS=
